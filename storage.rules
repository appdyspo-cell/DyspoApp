rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    // ── User avatars ──────────────────────────────────────────────────────────
    // Path: avatarsStorage/avatar_{uid}.jpg  (fichier plat, pas de sous-dossier)
    // Seul le propriétaire peut écrire son propre avatar ; tout utilisateur
    // authentifié peut lire (affichage des avatars dans l'app).
    match /avatarsStorage/{filename} {
      allow read:  if isAuth();
      allow write: if isAuth()
        && filename == 'avatar_' + request.auth.uid + '.jpg'
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Group / event avatars and event media ─────────────────────────────────
    // These paths do not embed the owner UID in the bucket path, so membership
    // is enforced by Firestore rules (which restrict who can reach these uploads).
    // Require authentication for all operations, and additionally restrict
    // uploads to reasonably-sized images to prevent storage abuse / arbitrary
    // file hosting by any authenticated account.
    function isValidImageUpload() {
      return request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    match /avatarGroupsStorage/{allPaths=**} {
      allow read:  if isAuth();
      allow write: if isAuth() && isValidImageUpload();
    }

    match /avatarEventsStorage/{allPaths=**} {
      allow read:  if isAuth();
      allow write: if isAuth() && isValidImageUpload();
    }

    match /eventsMediaStorage/{allPaths=**} {
      allow read:  if isAuth();
      allow write: if isAuth() && isValidImageUpload();
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
